{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "opengrep",
          "rules": [
            {
              "id": "opt.opengrep-rules.generic.secrets.security.detected-generic-api-key",
              "shortDescription": {
                "text": "Generic API Key detected"
              },
              "properties": {
                "tags": [
                  "security"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "opt.opengrep-rules.generic.secrets.security.detected-generic-api-key",
          "message": {
            "text": "Generic API Key detected"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config.py"
                },
                "region": {
                  "startLine": 9,
                  "snippet": {
                    "text": "Xk9mP2vL5nQ8wR3jT6yB4cF7hG1sD0eA"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
