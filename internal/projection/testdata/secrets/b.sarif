                "level": "error"
              },
              "properties": {
                "tags": [
                  "secret",
                  "security",
                  "HIGH"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "stripe-secret-token",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Secret: stripe-secret-token"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config.py",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 12,
                  "endLine": 9,
                  "endColumn": 44,
                  "snippet": {
                    "text": "Xk9mP2vL5nQ8wR3jT6yB4cF7hG1sD0eA"
