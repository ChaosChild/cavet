  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "version": "0.74.0",
          "rules": [
            {
              "id": "stripe-secret-token",
              "name": "Secret",
              "shortDescription": {
                "text": "Stripe secret token"
