              "shortDescription": {
                "text": "Missing description for security group."
              },
              "fullDescription": {
                "text": "Security groups should include a description for auditing purposes.\n\nSimplifies auditing, debugging, and managing security groups.\n"
              },
              "defaultConfiguration": {
